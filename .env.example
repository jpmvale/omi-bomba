# Variáveis do OmiBomba. Copie para `.env` (que o git ignora).
# Em desenvolvimento nenhuma é obrigatória; em produção, só o segredo.

# Assina o token de sessão de cada jogador. Em produção é OBRIGATÓRIA, com 32+
# caracteres aleatórios: `openssl rand -base64 48`. Trocar desloga todo mundo
# (as salas vivas perdem os jogadores, que entram de novo pelo link).
OMI_BOMBA_SESSION_SECRET=

# Onde ficam as salas vivas. Vazio = memória do processo (só para dev: um
# reinício derruba as salas). `npm run redis` sobe um na porta 6381.
REDIS_URL=redis://localhost:6381

# Origem aceita no WebSocket. Em dev o Vite roda em 5173.
ALLOWED_ORIGIN=http://localhost:5173

# Porta HTTP do servidor.
PORT=3000

# Só atrás do Caddy: confia no X-Forwarded-For para o limite por IP.
TRUST_PROXY=0

# Versão que o /api/health mostra. Na VPS é o sha curto da imagem.
OMI_BOMBA_VERSION=dev
