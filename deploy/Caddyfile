# Bloco do OmiBomba para o FIM de ~/caddy/Caddyfile na VPS (cópia versionada em
# vps-infra/caddy/Caddyfile). Um destino só: o processo serve o cliente e a API,
# e o Caddy 2 repassa o Upgrade do WebSocket sozinho.
#
# Sem `import csp_em_vigor`: o servidor manda a própria CSP, com nonce.
omi-bomba.imp-software.cloud {
	import seguranca
	encode gzip zstd

	reverse_proxy omi-bomba-api:3000

	log {
		output file /var/log/caddy/omi-bomba.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
